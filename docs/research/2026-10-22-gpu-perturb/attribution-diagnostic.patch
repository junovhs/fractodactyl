-        Err(e) => {
-            eprintln!("fd gpu-perturb: {e}; CPU restart from zero");
-            return fd_kernel::render_with(view, p, Some((r, bits)));
-        }
-    };
-    let gpu_seconds = gpu_started.elapsed().as_secs_f64();
-    let output = words(&output);
-    let mut candidates = vec![None; count];
-    let mut guard = 0;
-    let mut unfinished = 0;
-    let mut invalid = 0;
-    let mut iterations = 0u64;
-    for (k, row) in output.chunks_exact(20).enumerate() {
-        let (m, n, status) = (row[16] as usize, row[17], row[18]);
-        iterations += u64::from(n);
-        if status != 1 {
-            if status >= 2 {
-                invalid += 1;
-            } else {
-                unfinished += 1;
-            }
-            continue;
-        }
-        if m >= rq.len() {
-            invalid += 1;
-            continue;
-        }
-        let delta = unpack(row, 0);
-        let derivative = (
-            f64::from(f32::from_bits(row[4])),
-            f64::from(f32::from_bits(row[5])),
-        );
-        let dexp = i64::from(row[6] as i32);
-        let z = (r.re[m] + delta.0, r.im[m] + delta.1);
-        let ez = unpack(&row[8..], 0).0 + q[m] + 8.0 * f64::EPSILON * l1(z);
-        let ed = unpack(&row[12..], -dexp).0;
-        let s = EscapedState {
-            n: u64::from(n),
-            z,
-            derivative,
-            derivative_exponent: dexp,
-        };
-        if z.0.hypot(z.1) - ez > p.escape_radius
-            && fd_kernel::external_escape_ok(&s, ez, ed, (plane.h_m * f64::from(p.ss), plane.h_e))
-        {
-            candidates[k] = Some(s);
-        } else {
-            guard += 1;
-        }
-    }
-    let admitted = candidates.iter().filter(|s| s.is_some()).count();
-    if let Some(count) = admission {
-        *count = admitted;
-    }
-    let mask: Vec<_> = candidates.iter().map(Option::is_none).collect();
-    let fallback_started = Instant::now();
-    let (mut h, mut s, mut st) = fd_kernel::render_with_masked(view, p, Some((r, bits)), &mask)?;
-    fd_kernel::overlay_escaped(view, p, &mut s, &candidates)?;
-    st.reference_seconds = reference_seconds;
-    st.iterations += iterations;
-    let fallback_seconds = fallback_started.elapsed().as_secs_f64();
-    h.kernel.push_str(" gpu-perturb-f32x/1");
-    eprintln!("fd gpu-perturb: adapter={adapter:?} accepted={admitted} fallback={} guard={guard} unfinished={unfinished} invalid={invalid} gpu_seconds={gpu_seconds:.6} cpu_fallback_seconds={fallback_seconds:.6} total_seconds={:.6} restart=zero max_gpu_steps={GPU_STEPS}",count-admitted,started.elapsed().as_secs_f64());
-    Ok((h, s, st))
-}
-
-#[cfg(test)]
-mod tests {
-    use super::*;
-    use fd_samples::{Column, ColumnSet};
-    #[test]
-    #[ignore = "actual GPU corruption/uncertainty rejection and complete CPU restart"]
-    fn gpu_perturb_guard_restarts_corrupted_reference() {
-        let view = View {
-            center_re: "1".into(),
-            center_im: "0.5".into(),
-            width: "0.25".into(),
-            rotation: 0.0,
-        };
-        let p = Params {
-            nx: 8,
-            ny: 8,
-            ss: 1,
-            max_iter: 256,
-            escape_radius: 1e10,
-            columns: ColumnSet::of(&[Column::Nu, Column::De, Column::Normal]),
-            threads: 1,
-            tier: None,
-        };
-        let (expected_h, expected) = fd_kernel::render(&view, &p).unwrap();
-        let mut accepted = usize::MAX;
-        // Corrupt GPU reference values by +100 while carrying their full transport
-        // radius. No lossy state may enter the final frame (DEC-25).
-        let (mut h, s, _) = render_inner(&view, &p, None, 100.0, Some(&mut accepted)).unwrap();
-        assert_eq!(
-            accepted, 0,
-            "must dispatch and reject every corrupted candidate"
-        );
-        h.kernel = expected_h.kernel.clone();
-        let (mut a, mut b) = (Vec::new(), Vec::new());
-        fd_samples::write(&mut a, &h, &s).unwrap();
-        fd_samples::write(&mut b, &expected_h, &expected).unwrap();
