#version 450
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0, std430) readonly buffer Outer { uint outer_rgb[]; };
layout(set = 0, binding = 1, std430) readonly buffer Inner { uint inner_rgb[]; };
layout(set = 0, binding = 2, std430) writeonly buffer Output { uint out_rgb[]; };
layout(set = 0, binding = 3, std430) readonly buffer GammaDecode { float gamma_lut[]; };

layout(push_constant) uniform Parameters {
    uvec4 dims; // output width, output height, outer width, outer height
    uvec4 more; // inner width, inner height
    vec4 zoom;  // outer z, inner z, outer x, outer y
    vec4 blend; // inner x, inner y, ramp, edge margin
} p;

vec3 linear_rgb(uint packed) {
    return vec3(gamma_lut[packed & 255u],
                gamma_lut[(packed >> 8) & 255u],
                gamma_lut[(packed >> 16) & 255u]);
}

vec3 gather_rgb(bool inner, vec2 at, float radius) {
    uint w = inner ? p.more.x : p.dims.z;
    uint h = inner ? p.more.y : p.dims.w;
    vec2 c = at * vec2(w, h) + vec2(w, h) / 2.0;
    float f = max(1.0, radius);
    ivec2 lo = ivec2(floor(c - vec2(f)));
    ivec2 hi = ivec2(ceil(c + vec2(f)));
    vec3 accum = vec3(0.0);
    float total = 0.0;
    for (int sy = lo.y; sy <= hi.y; ++sy) {
        float wy = 1.0 - abs(float(sy) + 0.5 - c.y) / f;
        if (wy <= 0.0) continue;
        uint y = uint(clamp(sy, 0, int(h) - 1));
        for (int sx = lo.x; sx <= hi.x; ++sx) {
            float wx = 1.0 - abs(float(sx) + 0.5 - c.x) / f;
            if (wx <= 0.0) continue;
            uint x = uint(clamp(sx, 0, int(w) - 1));
            float weight = wx * wy;
            uint packed = inner ? inner_rgb[y * w + x] : outer_rgb[y * w + x];
            accum += linear_rgb(packed) * weight;
            total += weight;
        }
    }
    return accum / max(total, 1e-12);
}

void main() {
    uvec2 pixel = gl_GlobalInvocationID.xy;
    if (pixel.x >= p.dims.x || pixel.y >= p.dims.y) return;
    vec2 uv = (vec2(pixel) + 0.5) / vec2(p.dims.xy) - 0.5;
    vec2 zi = uv * p.zoom.y + p.blend.xy;
    float distance_to_edge = max(abs(2.0 * zi.x), abs(2.0 * zi.y));
    float wi = p.blend.z * clamp((1.0 - distance_to_edge) / p.blend.w, 0.0, 1.0);
    vec3 col = vec3(0.0);
    if (wi < 1.0) {
        float f = 0.5 * p.zoom.x * float(p.dims.z) / float(p.dims.x);
        col = gather_rgb(false, uv * p.zoom.x + p.zoom.zw, f) * (1.0 - wi);
    }
    if (wi > 0.0) {
        float f = 0.5 * p.zoom.y * float(p.more.x) / float(p.dims.x);
        col += gather_rgb(true, zi, f) * wi;
    }
    uvec3 rgb = uvec3(clamp(pow(clamp(col, 0.0, 1.0), vec3(1.0 / 2.2))
                          * 255.0 + 0.5, 0.0, 255.0));
    out_rgb[pixel.y * p.dims.x + pixel.x] = rgb.r | (rgb.g << 8) | (rgb.b << 16);
}
