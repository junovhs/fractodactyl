#version 450
layout(local_size_x = 8, local_size_y = 8) in;
// Time-invariant per-sample studio relief and band anti-aliasing. One dispatch per
// newly uploaded keyframe, not once per output frame.
layout(set = 0, binding = 0, std430) readonly buffer Samples { uvec4 sample_data[]; };
layout(set = 0, binding = 1, std430) writeonly buffer Prepared { uvec4 cooked[]; };
layout(push_constant) uniform Parameters {
    uvec4 dims;
    uvec4 rect;
    vec4 tone;
    vec4 light;
    vec4 color;
    vec4 extra;
} p;
void main() {
    uvec2 xy = gl_GlobalInvocationID.xy;
    if (xy.x >= p.dims.x || xy.y >= p.dims.y) return;
    uint i = xy.y * p.dims.x + xy.x;
    uvec4 s = sample_data[i];
    uint kind = s.w >> 16;
    if (kind != 0u) {
        // Encode interior=-1 and unresolved=-2 in the band slot; retain
        // both exact f64 phase words for escaped samples.
        cooked[i] = uvec4(s.x, s.y, floatBitsToUint(-float(kind)), floatBitsToUint(0.0));
        return;
    }
    float d = max(uintBitsToFloat(s.z), 0.0);
    float angle = float(s.w & 65535u) * (6.2831853071795864769 / 65536.0);
    vec2 normal = vec2(cos(angle), sin(angle));
    float facing = -dot(normal, p.light.xy);
    float cycles = p.tone.y * 2.0 / (max(d, 1e-30) * 0.6931471805599453);
    float band = 1.0;
    if (p.extra.z > 0.5) {
        const float sigma = 0.5;
        float band_k = -2.0 * pow(3.14159265358979323846 * sigma, 2.0);
        band = exp(band_k * cycles * cycles);
    }
    float steep = tanh(0.6 * log(1.0 + cycles / 0.02));
    float fade = p.extra.z > 0.5 ? tanh(d / 0.7) : 1.0;
    float v = (1.0 + p.tone.w * facing * steep * fade)
            * (1.0 - 0.6 * exp(-d * 1.5));
    cooked[i] = uvec4(s.x, s.y, floatBitsToUint(band), floatBitsToUint(v));
}
