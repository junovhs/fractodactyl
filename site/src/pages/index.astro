---
// fractodactyl.dev: the plain-language explainer. Static HTML and CSS, no client script.
// A clean, readable page with a tint of the viewer's 90s look: slim title strips on the
// cards, a viewer-style frame for Fig. 1, bevelled buttons, the pixel banner and the
// mascot. The top nav stays on this page; only the Docs link goes to /docs/ (written by
// dopedocs from src/docs.ts). Colour pairs are declared below and checked by check-home.sh.
const repo = "https://github.com/junovhs/fractodactyl";
const pic = (name: string) => ({
  src: `/img/${name}-1600.webp`,
  srcset: `/img/${name}-800.webp 800w, /img/${name}-1600.webp 1600w`,
});
const nav = [
  ["#about", "About"],
  ["#rules", "Rules"],
  ["#speed", "Speed"],
  ["#receipts", "Receipts"],
  ["#explorer", "Explorer"],
  ["#plans", "Plans"],
];
const ticker = [
  "z ↦ z² + c",
  "period-764 minibrot at width 1e-48 in 0.25 s",
  "0 wrong pixels out of 777,600",
  "built in public",
  "every frame is the real set",
  "the pterodactyl is load-bearing",
];
const shots = [
  { n: "elephant", place: "Elephant Valley", look: "master-ice" },
  { n: "antenna", place: "Antenna minibrot", look: "ice" },
  { n: "deepvalley", place: "Deep valley, 1.3e12×", look: "smoke" },
  { n: "coral", place: "Seahorse Valley", look: "coral" },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Fractodactyl: deep Mandelbrot zooms, built in public</title>
    <meta name="description" content="Fractodactyl aims to be the fastest deep Mandelbrot zoom renderer that never fakes a frame. Open source, built in public." />
    <link rel="canonical" href="https://fractodactyl.dev/" />
    <link rel="icon" href="/favicon.png" />
    <meta property="og:title" content="Fractodactyl" />
    <meta property="og:description" content="Deep Mandelbrot zooms, built in public." />
    <meta property="og:image" content="https://fractodactyl.dev/img/minibrot-1600.webp" />
    <link rel="stylesheet" href="/docs-theme.css" />
    <style is:inline>
      /* Page colours. Text pairs meet WCAG AA (4.5:1); check-home.sh verifies each:
         aa: --c-ink on --c-bg        aa: --c-ink on --c-card       aa: --c-soft on --c-bg
         aa: --c-soft on --c-card     aa: --c-muted on --c-bg       aa: --c-muted on --c-card
         aa: --c-link on --c-card     aa: --c-link on --c-bg        aa: --c-strip-ink on --c-strip
         aa: --c-ink on --c-btn       aa: --c-ink on --c-nav        aa: --c-orange-ink on --c-card
         aa: --c-pink-ink on --c-card aa: --c-purple-ink on --c-card aa: --c-tick-ink on --c-tick
         aa: --c-stamp-ink on --c-stamp aa: --c-ink on --c-orange    aa: --c-ink on --c-pink
         aa: --c-vbar-ink on --c-vbar  aa: --c-vbar-ink on --c-vbar-lo  aa: --c-stamp-ink on --c-stamp */
      :root {
        --c-bg: #f5f3ee;
        --c-card: #ffffff;
        --c-ink: #1a1814;
        --c-soft: #45403a;
        --c-muted: #5e584f;
        --c-line: #d9d5cc;
        --c-link: #1d3fd1;
        --c-strip: #e6e4fb;
        --c-strip-ink: #262a6e;
        --c-btn: #dedbd4;
        --c-nav: #ece9e2;
        --c-orange: #ffa94d;
        --c-orange-ink: #8a3c00;
        --c-pink: #ff8fc0;
        --c-pink-ink: #9b1458;
        --c-purple-ink: #4b20b0;
        --c-tick: #14161c;
        --c-tick-ink: #a6f07a;
        --c-stamp: #0a2fd6;
        --c-stamp-ink: #ffffff;
        --c-frame: #3a45bf;
        --c-vbar: #4a55cf;
        --c-vbar-lo: #333da8;
        --c-vbar-ink: #ffffff;
      }
    </style>
  </head>
  <body>
    <header class="top">
      <a class="brand" href="#top"><img src="/img/ui/mascot-icon.png" alt="" width="34" height="28" /><span>Fractodactyl</span></a>
      <nav aria-label="On this page">
        {nav.map(([href, label]) => <a href={href}>{label}</a>)}
      </nav>
      <div class="out">
        <a class="b95" href="/docs/">Docs</a>
        <a class="gh" href={repo}>GitHub ↗</a>
      </div>
    </header>

    <section class="hero wrap" id="top">
      <div class="hero-copy">
        <img class="banner" src="/img/ui/banner-band.png" alt="Fractodactyl: Explore the Infinite! A pixel-art pterodactyl banner." width="640" height="66" />
        <h1>A deep-zoom renderer for the Mandelbrot set that never fakes a frame.</h1>
        <p class="lede">Fractodactyl is open source and built in public. We aim to make it the fastest way to render deep zoom films: films that go much deeper and run much longer than today's, made much faster, where every pixel is the real set at that depth.</p>
        <p class="actions"><a class="b95 primary" href="#speed">See how it works</a><a class="b95" href="/docs/">Read the docs</a></p>
      </div>
      <div class="hero-art">
        <img class="mascot" src="/img/ui/mascot-900.webp" srcset="/img/ui/mascot-450.webp 450w, /img/ui/mascot-900.webp 900w" sizes="(max-width: 820px) 60vw, 340px" alt="Fractodactyl's mascot: a grinning pterodactyl in sunglasses with fractal-patterned wings" width="900" height="750" />
        <span class="stamp">100%<br />real set</span>
      </div>
    </section>

    <div class="ticker" aria-hidden="true"><div class="track">{[0, 1].map(() => ticker.map((t) => <span>{t}</span>))}</div></div>

    <main class="wrap">
      <figure class="viewer">
        <div class="vbar"><span>minibrot-764.fds · fd-viewer</span><b class="btns" aria-hidden="true"><i></i><i></i><i class="x"></i></b></div>
        <img {...pic("minibrot")} sizes="(max-width: 980px) 100vw, 920px" alt="A period-764 minibrot at width 1e-48, rendered by fd" width="1600" height="900" fetchpriority="high" />
        <figcaption class="status"><span>Fig. 1 · period-764 minibrot</span><span>width 1e-48</span><span>0.25 s</span><span>zone-wgpu-f64</span></figcaption>
      </figure>

      <section class="card" id="about">
        <p class="strip">readme.txt</p>
        <div class="body">
          <h2>What this is</h2>
          <p>A deep zoom dives into the Mandelbrot set until the screen is far smaller than an atom, and then keeps going. The set never runs out of detail, but the arithmetic gets harder the deeper you go, which is why long, deep zoom films are rare and slow to make. We're working to make them routine.</p>
          <dl class="spec">
            <div><dt>Language</dt><dd>Rust, with the GPU code in WGSL on wgpu</dd></div>
            <div><dt>Aims to run on</dt><dd>Windows and Linux, any modern GPU, or no GPU at all</dd></div>
            <div><dt>Tested on so far</dt><dd>AMD RX 5700 XT, Mesa lavapipe, DX12 WARP</dd></div>
            <div><dt>Licence</dt><dd>MIT or Apache-2.0</dd></div>
            <div><dt>Mascot</dt><dd>One pterodactyl, sunglasses non-optional</dd></div>
          </dl>
        </div>
      </section>

      <section class="card" id="rules">
        <p class="strip">house_rules.txt</p>
        <div class="body">
          <h2>House rules</h2>
          <p>Every idea in the project has to pass three tests, in this order, or it doesn't ship.</p>
          <ol class="rules">
            <li><b class="n o">1</b><div><strong>It shows the real set.</strong> Every frame is the actual Mandelbrot set at that place and depth. We never swap in a look-alike location to save time.</div></li>
            <li><b class="n p">2</b><div><strong>It looks perfect, measurably.</strong> A viewer can't tell a film frame from an exact render of the same frame, and <code>fd filmcheck</code> checks that on every frame.</div></li>
            <li><b class="n v">3</b><div><strong>It earns its keep.</strong> It makes zooms faster, deeper or longer. Ideas that stop paying off get dropped, with a note in the log about why.</div></li>
          </ol>
        </div>
      </section>

      <section class="card" id="speed">
        <p class="strip">speed.exe</p>
        <div class="body">
          <h2>Where the speed comes from</h2>
          <p>A conventional renderer follows each pixel's orbit step by step, often for hundreds of thousands of steps. Near a minibrot, Fractodactyl uses exact results about how those orbits behave (theorems of Tan Lei and Koenigs) to replace most of the steps with a few loops of a small map and one exact jump. It's a shortcut the maths guarantees, not a guess, and every result is checked against full-precision renders.</p>
          <div class="pair">
            <figure><img {...pic("seahorse")} sizes="(max-width: 700px) 100vw, 440px" alt="Seahorse Valley in the master-ice look" width="1600" height="900" loading="lazy" /><figcaption>Seahorse Valley, width 0.0065, master-ice.</figcaption></figure>
            <figure><img {...pic("spiral")} sizes="(max-width: 700px) 100vw, 440px" alt="A spiral near M(24,2) at width 1e-24 in the coral look" width="1600" height="900" loading="lazy" /><figcaption>Spiral at M(24,2), width 1e-24, coral: 4.1 s on the ordinary kernel.</figcaption></figure>
          </div>
          <p class="note">Fig. 1 is twenty-four decades deeper than the spiral and took 0.25 s on the fast path.</p>
        </div>
      </section>

      <section class="card" id="receipts">
        <p class="strip">receipts.xls</p>
        <div class="body">
          <h2>Receipts</h2>
          <p>Measurements on the zoom paths we've tested so far, each against the best renderer that could use the same trick. Making the fast path cover any film is the big open problem we're working on.</p>
          <table class="sheet">
            <thead><tr><th scope="col">Speed-up</th><th scope="col">What was measured</th></tr></thead>
            <tbody>
              <tr><td class="num o">8-25×</td><td>Deep frames near a minibrot, against fd's own BLA renderer. 0 wrong pixels out of 777,600.</td></tr>
              <tr><td class="num p">~1000×</td><td>Frames at a depth of 1e-1000: 0.023 s against 23-42 s, every pixel correct.</td></tr>
              <tr><td class="num v">5×</td><td>A whole 10-second 1080p60 film on the GPU: 36.6 s against 183.6 s on every CPU core.</td></tr>
            </tbody>
          </table>
          <p class="note">Every number has its command and data in the public results log, filed right next to the ideas that didn't work.</p>
        </div>
      </section>

      <section class="card" id="explorer">
        <p class="strip">explorer.exe</p>
        <div class="body">
          <h2>The explorer</h2>
          <p><code>fd-viewer</code> is our desktop explorer for wandering the set, picking places for films and trying looks. It's an early build that already drives the real renderer, and it has a pterodactyl in the title bar because we have standards.</p>
          <div class="shots">
            {shots.map((s) => (
              <figure>
                <img src={`/img/viewer-${s.n}-1280.webp`} srcset={`/img/viewer-${s.n}-640.webp 640w, /img/viewer-${s.n}-1280.webp 1280w`} sizes="(max-width: 700px) 100vw, 440px" alt={`fd-viewer showing ${s.place} in the ${s.look} look`} width="1280" height="1082" loading="lazy" />
                <figcaption>{s.place}, {s.look}.</figcaption>
              </figure>
            ))}
          </div>
          <p class="note">Unedited screenshots. Switching looks only recolours the picture; the maths isn't redone.</p>
        </div>
      </section>

      <section class="card" id="plans">
        <p class="strip">todo.txt</p>
        <div class="body">
          <h2>What we're working on</h2>
          <ul class="todo">
            <li><span class="box" aria-hidden="true"></span><div><strong>Fast paths for any film.</strong> We're working to find and build the shortcuts automatically for any zoom path, not only the ones tested so far.</div></li>
            <li><span class="box" aria-hidden="true"></span><div><strong>Directed films.</strong> We aspire to a trip planner that finds minibrots, spirals and embedded Julia sets and strings them into journeys with proper climaxes.</div></li>
            <li><span class="box" aria-hidden="true"></span><div><strong>A native explorer.</strong> We aim to rebuild the viewer in Rust, drawing through the same pipeline as the films.</div></li>
          </ul>
          <p class="actions"><a class="b95 primary" href="/docs/">Read the docs</a><a class="b95" href={repo}>Follow along on GitHub</a></p>
        </div>
      </section>
    </main>

    <footer class="foot wrap">
      <img src="/img/ui/mascot-icon.png" alt="" width="40" height="33" />
      <p>Fractodactyl is open source (MIT or Apache-2.0) and built in public. Made with z² + c and an unreasonable amount of precision. <a href={repo}>github.com/junovhs/fractodactyl</a></p>
    </footer>
  </body>
</html>

<style is:global>
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; scroll-padding-top: 72px; -webkit-text-size-adjust: 100%; }
  body { margin: 0; background: var(--c-bg); color: var(--c-ink); font: 400 17px/1.65 var(--fd-sans); }
  a { color: var(--c-link); text-underline-offset: 2px; }
  a:focus-visible, .b95:focus-visible { outline: 2px solid var(--c-link); outline-offset: 2px; }
  img { display: block; max-width: 100%; height: auto; }
  code { font: 0.88em var(--fd-mono); background: #efece6; padding: 0.1em 0.35em; border-radius: 3px; }
  .wrap { max-width: 980px; margin: 0 auto; padding: 0 20px; }

  /* Top bar: a light menu bar; anchors stay on the page. */
  .top { position: sticky; top: 0; z-index: 5; display: flex; align-items: center; gap: 20px; padding: 8px 20px; background: var(--c-nav); border-bottom: 1px solid var(--c-line); box-shadow: 0 1px 0 #fff inset; }
  .brand { display: flex; align-items: center; gap: 8px; color: var(--c-ink); text-decoration: none; font-weight: 700; }
  .top nav { display: flex; gap: 2px; flex-wrap: wrap; }
  .top nav a { padding: 4px 10px; color: var(--c-ink); text-decoration: none; font-size: 15px; border-radius: 3px; }
  .top nav a:hover { background: var(--c-stamp); color: #fff; }
  .out { margin-left: auto; display: flex; align-items: center; gap: 14px; }
  .gh { font-size: 15px; }
  .b95 { display: inline-block; padding: 7px 16px; background: var(--c-btn); color: var(--c-ink); font: 600 15px var(--fd-sans); text-decoration: none; border-radius: 2px;
    box-shadow: inset -1px -1px 0 #3d3a36, inset 1px 1px 0 #fff, inset -2px -2px 0 #8d8981, inset 2px 2px 0 #f2f0eb; }
  .b95:hover { background: #e7e4dd; }
  .b95:active { box-shadow: inset 1px 1px 0 #3d3a36, inset -1px -1px 0 #fff, inset 2px 2px 0 #8d8981; }
  .b95.primary { background: var(--c-orange); }
  .b95.primary:hover { background: #ffb866; }
  @media (max-width: 820px) { .top { flex-wrap: wrap; gap: 8px 14px; position: static; } .top nav { order: 3; width: 100%; } }

  /* Hero */
  .hero { display: grid; grid-template-columns: 1fr 320px; gap: 24px; align-items: center; padding-top: 40px; padding-bottom: 36px; }
  .banner { width: 640px; max-width: 100%; image-rendering: pixelated; border: 1px solid var(--c-line); margin-bottom: 26px; }
  h1 { margin: 0 0 16px; font: 700 clamp(1.8rem, 3.6vw, 2.6rem)/1.15 var(--fd-display); letter-spacing: -0.02em; }
  .lede { margin: 0; font-size: 1.1rem; color: var(--c-soft); max-width: 60ch; }
  .actions { display: flex; flex-wrap: wrap; gap: 10px; margin: 24px 0 0; }
  .hero-art { position: relative; }
  .mascot { width: 100%; animation: glide 6s ease-in-out infinite; }
  @keyframes glide { 50% { transform: translateY(-8px) rotate(-1.5deg); } }
  .stamp { position: absolute; left: 0; bottom: 4%; display: grid; place-items: center; width: 86px; height: 86px; border-radius: 50%; background: var(--c-stamp); color: var(--c-stamp-ink); font: 700 12px/1.15 var(--fd-mono); text-align: center; text-transform: uppercase; transform: rotate(-12deg); border: 2px dashed rgba(255,255,255,.75); outline: 3px solid var(--c-stamp); }
  @media (max-width: 820px) { .hero { grid-template-columns: 1fr; } .hero-art { max-width: 260px; margin: 0 auto; } }

  .ticker { overflow: hidden; background: var(--c-tick); color: var(--c-tick-ink); font: 13px var(--fd-mono); }
  .ticker .track { display: flex; width: max-content; animation: scroll 45s linear infinite; }
  .ticker span { padding: 7px 0; white-space: nowrap; }
  .ticker span::after { content: "✶"; margin: 0 20px; color: var(--c-orange); }
  @keyframes scroll { to { transform: translateX(-50%); } }

  main { display: grid; grid-template-columns: minmax(0, 1fr); gap: 28px; padding-top: 36px; padding-bottom: 48px; }

  /* Fig. 1 in a light take on the viewer's window */
  .viewer { margin: 0; border: 1px solid var(--c-frame); border-radius: 6px; overflow: hidden; background: #fff; box-shadow: 0 6px 18px rgba(30, 30, 60, .12); }
  .vbar { display: flex; align-items: center; gap: 8px; padding: 5px 6px 5px 12px; background: linear-gradient(var(--c-vbar), var(--c-vbar-lo)); color: var(--c-vbar-ink); font: 600 13px var(--fd-sans); text-shadow: 0 1px 0 rgba(0,0,0,.35); }
  .vbar span { flex: 1; }
  .btns { display: flex; gap: 3px; }
  .btns i { width: 18px; height: 16px; border: 1px solid #333886; border-radius: 3px; background: #d4cbf2; }
  .btns i.x { background: #fa4b6c; }
  .status { display: flex; flex-wrap: wrap; gap: 4px 16px; padding: 7px 12px; background: var(--c-nav); border-top: 1px solid var(--c-line); font: 13px var(--fd-mono); color: var(--c-ink); }

  /* Section cards with a slim 90s title strip */
  .card { background: var(--c-card); border: 1px solid var(--c-line); border-radius: 6px; overflow: hidden; }
  .strip { margin: 0; padding: 5px 14px; background: var(--c-strip); color: var(--c-strip-ink); border-bottom: 1px solid #cfcbf2; font: 600 13px var(--fd-mono); }
  .body { padding: 22px 26px 24px; }
  .body h2 { margin: 0 0 10px; font: 700 24px/1.2 var(--fd-display); letter-spacing: -0.01em; }
  .body > p { max-width: 70ch; margin: 0 0 14px; }
  .note { font-size: 15px; color: var(--c-muted); }

  .spec { margin: 8px 0 0; border-top: 1px solid var(--c-line); }
  .spec div { display: grid; grid-template-columns: 170px 1fr; gap: 12px; padding: 9px 0; border-bottom: 1px solid var(--c-line); }
  .spec dt { font-weight: 600; } .spec dd { margin: 0; color: var(--c-soft); }
  @media (max-width: 560px) { .spec div { grid-template-columns: 1fr; gap: 0; } }

  .rules, .todo { list-style: none; margin: 6px 0 0; padding: 0; display: grid; gap: 14px; }
  .rules li, .todo li { display: grid; grid-template-columns: 36px 1fr; gap: 12px; align-items: start; }
  .rules .n { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 50%; color: var(--c-ink); font: 700 15px var(--fd-mono); border: 1px solid var(--c-ink); }
  .n.o { background: var(--c-orange); } .n.p { background: var(--c-pink); } .n.v { background: #c9b8ff; }
  .todo .box { width: 18px; height: 18px; margin: 5px 0 0 8px; background: #fff; box-shadow: inset 1px 1px 0 #8d8981, inset -1px -1px 0 #fff, inset 2px 2px 0 #3d3a36; }

  figure { margin: 0; }
  figure img { border-radius: 4px; }
  figcaption { font-size: 14px; color: var(--c-muted); margin-top: 6px; }
  .viewer figcaption { margin: 0; }
  .viewer img { border-radius: 0; }
  .pair, .shots { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin: 6px 0 16px; }
  .shots img { border: 1px solid var(--c-line); }
  @media (max-width: 700px) { .pair, .shots { grid-template-columns: 1fr; } }

  .sheet { width: 100%; border-collapse: collapse; margin: 6px 0 12px; font-size: 16px; }
  .sheet th { text-align: left; font: 600 13px var(--fd-mono); color: var(--c-soft); background: var(--c-nav); padding: 7px 12px; border: 1px solid var(--c-line); }
  .sheet td { padding: 10px 12px; border: 1px solid var(--c-line); vertical-align: top; }
  .sheet .num { font: 700 24px/1.1 var(--fd-display); white-space: nowrap; }
  .num.o { color: var(--c-orange-ink); } .num.p { color: var(--c-pink-ink); } .num.v { color: var(--c-purple-ink); }

  .foot { display: flex; align-items: center; gap: 14px; padding-top: 20px; padding-bottom: 36px; border-top: 1px solid var(--c-line); font-size: 15px; color: var(--c-soft); }
  .foot p { margin: 0; }

  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } .mascot, .ticker .track { animation: none; } }
</style>
