---
// fractodactyl.dev: the plain-language explainer. Static HTML and CSS, no client script.
// The documentation pages under /docs/ are written by dopedocs from src/docs.ts.
// Look: a tidy technical page (grid, mono labels) with a 90s-desktop twist: figures in
// little window frames, bevelled buttons, a marquee, and the mascot front and centre.
const repo = "https://github.com/junovhs/fractodactyl";
const pic = (name: string) => ({
  src: `/img/${name}-1600.webp`,
  srcset: `/img/${name}-800.webp 800w, /img/${name}-1600.webp 1600w`,
});
const ticker = [
  "z ↦ z² + c",
  "period-764 minibrot at width 1e-48 in 0.25 s",
  "0 wrong pixels out of 777,600",
  "built in public",
  "every frame is the real set",
  "the pterodactyl is load-bearing",
  "1e-1000 and counting",
];
const measured = [
  { n: "8-25×", what: "faster deep frames near a minibrot than fd's own BLA renderer, with 0 wrong pixels out of 777,600.", c: "orange" },
  { n: "~1000×", what: "faster at a depth of 1e-1000: 0.023 s a frame against 23-42 s, every pixel correct.", c: "pink" },
  { n: "5×", what: "faster for a whole 10-second 1080p60 film on the GPU: 36.6 s against 183.6 s on every CPU core.", c: "purple" },
];
const shots = [
  { n: "elephant", place: "Elephant Valley", look: "master-ice", tilt: -2 },
  { n: "antenna", place: "Antenna minibrot", look: "ice", tilt: 1.5 },
  { n: "deepvalley", place: "Deep valley, 1.3e12×", look: "smoke", tilt: 1 },
  { n: "coral", place: "Seahorse Valley", look: "coral", tilt: -1.5 },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Fractodactyl: deep Mandelbrot zooms, built in public</title>
    <meta name="description" content="Fractodactyl aims to be the fastest deep Mandelbrot zoom renderer that never fakes a frame. Open source, built in public." />
    <link rel="canonical" href="https://fractodactyl.dev/" />
    <link rel="icon" href="/favicon.png" />
    <meta property="og:title" content="Fractodactyl" />
    <meta property="og:description" content="Deep Mandelbrot zooms, built in public." />
    <meta property="og:image" content="https://fractodactyl.dev/img/minibrot-1600.webp" />
    <link rel="stylesheet" href="/docs-theme.css" />
  </head>
  <body>
    <header class="top">
      <a class="brand" href="/"><img src="/img/ui/mascot-icon.png" alt="" width="40" height="33" /><span>fractodactyl</span></a>
      <nav>
        <a href="/docs/how-its-fast/">how it works</a>
        <a href="/docs/results/">results</a>
        <a href="/docs/">docs</a>
        <a href={repo}>github ↗</a>
      </nav>
      <span class="status"><i></i>building in public</span>
    </header>

    <section class="hero wrap">
      <div class="hero-copy">
        <p class="label">fd · deep-zoom renderer · v0.1.0 · work in progress</p>
        <h1>We're building the fastest way to zoom deep into the Mandelbrot set without faking a single frame.</h1>
        <p class="lede">Fractodactyl is an open-source renderer for deep zoom films. We aim for films that go much deeper and run much longer than today's, made much faster, where every pixel is the real set at that depth. It's built in public, numbers and dead ends included.</p>
        <p class="actions"><a class="btn" href="/docs/what-it-is/">How it works</a><a class="btn alt" href={repo}>Source on GitHub</a></p>
      </div>
      <div class="hero-art">
        <img class="mascot" src="/img/ui/mascot-900.webp" srcset="/img/ui/mascot-450.webp 450w, /img/ui/mascot-900.webp 900w" sizes="(max-width: 900px) 70vw, 460px" alt="Fractodactyl's mascot: a grinning pterodactyl in sunglasses with fractal-patterned wings" width="900" height="750" />
        <span class="stamp">100%<br />real set</span>
      </div>
    </section>

    <div class="ticker" aria-hidden="true"><div class="track">
      {[0, 1].map(() => ticker.map((t) => <span>{t}</span>))}
    </div></div>

    <figure class="plate wrap">
      <div class="win">
        <div class="bar"><span>minibrot-764.fds · width 1e-48</span><i></i><i></i><i class="x"></i></div>
        <img {...pic("minibrot")} sizes="(max-width: 1180px) 100vw, 1140px" alt="A period-764 minibrot at width 1e-48, rendered by fd" width="1600" height="900" fetchpriority="high" />
      </div>
      <figcaption>Fig. 1: a period-764 minibrot, forty-eight decades down. 3200×1800 samples in 0.25 s on the GPU zone kernel, coloured by <code>fd</code> in the master-ice look.</figcaption>
    </figure>

    <main class="wrap">
      <section class="row">
        <h2 class="num"><b>01</b>What this is</h2>
        <div class="body">
          <p>A deep zoom dives into the Mandelbrot set until the screen is far smaller than an atom, and then keeps going. The set never runs out of detail, but the arithmetic gets harder the deeper you go, which is why long, deep zoom films are rare and slow to make. We're working to make them routine.</p>
          <dl class="spec">
            <div><dt>language</dt><dd>Rust, with the GPU code in WGSL on wgpu</dd></div>
            <div><dt>aims to run on</dt><dd>Windows and Linux, any modern GPU, or no GPU at all</dd></div>
            <div><dt>tested on so far</dt><dd>AMD RX 5700 XT, Mesa lavapipe, DX12 WARP</dd></div>
            <div><dt>licence</dt><dd>MIT or Apache-2.0</dd></div>
            <div><dt>mascot</dt><dd>one pterodactyl, sunglasses non-optional</dd></div>
          </dl>
        </div>
      </section>

      <section class="row">
        <h2 class="num"><b>02</b>House rules</h2>
        <div class="body">
          <p>Every idea in the project has to pass three tests, in this order, or it doesn't ship.</p>
          <div class="cards">
            <div class="card orange"><p class="k">rule 1</p><h3>It shows the real set</h3><p>Every frame is the actual Mandelbrot set at that place and depth. We never swap in a look-alike location to save time.</p></div>
            <div class="card pink"><p class="k">rule 2</p><h3>It looks perfect, measurably</h3><p>A viewer can't tell a film frame from an exact render of the same frame, and <code>fd filmcheck</code> checks that on every frame.</p></div>
            <div class="card purple"><p class="k">rule 3</p><h3>It earns its keep</h3><p>It makes zooms faster, deeper or longer. Ideas that stop paying off get dropped, with a note in the log about why.</p></div>
          </div>
        </div>
      </section>

      <section class="row">
        <h2 class="num"><b>03</b>Where the speed comes from</h2>
        <div class="body">
          <p>A conventional renderer follows each pixel's orbit step by step, often for hundreds of thousands of steps. Near a minibrot, Fractodactyl uses exact results about how those orbits behave (theorems of Tan Lei and Koenigs) to replace most of the steps with a few loops of a small map and one exact jump. It's a shortcut the maths guarantees, not a guess, and every result is checked against full-precision renders.</p>
          <div class="pair">
            <figure class="win sm">
              <div class="bar"><span>seahorse.fds · 0.0065</span><i></i><i></i><i class="x"></i></div>
              <img {...pic("seahorse")} sizes="(max-width: 800px) 100vw, 420px" alt="Seahorse Valley in the master-ice look" width="1600" height="900" loading="lazy" />
            </figure>
            <figure class="win sm">
              <div class="bar"><span>spiral-m24-2.fds · 1e-24</span><i></i><i></i><i class="x"></i></div>
              <img {...pic("spiral")} sizes="(max-width: 800px) 100vw, 420px" alt="A spiral near M(24,2) at width 1e-24 in the coral look" width="1600" height="900" loading="lazy" />
            </figure>
          </div>
          <p class="small">The spiral, at width 1e-24 in the coral look, took 4.1 s on the ordinary kernel. Fig. 1 is twenty-four decades deeper and took 0.25 s on the fast path.</p>
        </div>
      </section>

      <section class="row">
        <h2 class="num"><b>04</b>Receipts</h2>
        <div class="body">
          <p>These are measurements on the zoom paths we've tested so far, against the best renderer that could use the same trick. Making the fast path cover any film is the big open problem we're working on.</p>
          <div class="cards stats">
            {measured.map((m) => (<div class={`card ${m.c}`}><p class="big">{m.n}</p><p>{m.what}</p></div>))}
          </div>
          <p class="small">Every number has its command and data in the public results log, filed right next to the ideas that didn't work.</p>
        </div>
      </section>

      <section class="row" id="explorer">
        <h2 class="num"><b>05</b>The explorer</h2>
        <div class="body">
          <p><code>fd-viewer</code> is our desktop explorer for wandering the set, picking places for films and trying looks. It's an early build that already drives the real renderer, and it has a pterodactyl in the title bar because we have standards.</p>
          <div class="shots">
            {shots.map((s) => (
              <figure class="polaroid" style={`--tilt: ${s.tilt}deg`}>
                <img src={`/img/viewer-${s.n}-1280.webp`} srcset={`/img/viewer-${s.n}-640.webp 640w, /img/viewer-${s.n}-1280.webp 1280w`} sizes="(max-width: 800px) 100vw, 420px" alt={`fd-viewer showing ${s.place} in the ${s.look} look`} width="1280" height="1082" loading="lazy" />
                <figcaption><span>{s.place}</span><span class="look">{s.look}</span></figcaption>
              </figure>
            ))}
          </div>
          <p class="small">Unedited screenshots. Switching looks only recolours the picture; the maths isn't redone.</p>
        </div>
      </section>

      <section class="row">
        <h2 class="num"><b>06</b>What we're working on</h2>
        <div class="body">
          <ul class="plans">
            <li><b>Fast paths for any film.</b> We're working to find and build the shortcuts automatically for any zoom path, not only the ones tested so far.</li>
            <li><b>Directed films.</b> We aspire to a trip planner that finds minibrots, spirals and embedded Julia sets and strings them into journeys with proper climaxes.</li>
            <li><b>A native explorer.</b> We aim to rebuild the viewer in Rust, drawing through the same pipeline as the films.</li>
          </ul>
          <p class="actions"><a class="btn" href="/docs/">Read the docs</a></p>
        </div>
      </section>
    </main>

    <footer class="foot">
      <div class="wrap">
        <img src="/img/ui/mascot-icon.png" alt="" width="48" height="40" />
        <p>Fractodactyl is open source (MIT or Apache-2.0) and built in public. Made with z² + c and an unreasonable amount of precision.<br /><a href={repo}>github.com/junovhs/fractodactyl</a></p>
        <img class="tiny-banner" src="/img/ui/banner-band.png" alt="" width="320" height="33" />
      </div>
    </footer>
  </body>
</html>

<style is:global>
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body { margin: 0; background: var(--fd-bg); color: var(--fd-text); font: 400 17px/1.6 var(--fd-sans); }
  a { color: inherit; }
  code { font: 0.86em var(--fd-mono); background: var(--fd-panel-muted); padding: 0.1em 0.35em; border-radius: 3px; }
  img { display: block; max-width: 100%; height: auto; }
  .wrap { max-width: 1140px; margin: 0 auto; padding: 0 24px; }
  .label, .status, .top nav a, figcaption, .spec dt, .k, .bar span, .ticker { font-family: var(--fd-mono); }

  .top { position: sticky; top: 0; z-index: 5; display: flex; align-items: center; gap: 28px; padding: 10px 24px; background: color-mix(in srgb, var(--fd-bg) 90%, transparent); backdrop-filter: blur(8px); border-bottom: 2px solid var(--fd-text); }
  .brand { display: flex; align-items: center; gap: 10px; text-decoration: none; font-weight: 700; font-size: 18px; letter-spacing: -0.02em; }
  .top nav { display: flex; gap: 22px; margin-left: auto; }
  .top nav a { text-decoration: none; font-size: 13px; }
  .top nav a:hover { color: var(--fd-orange); }
  .status { display: inline-flex; align-items: center; gap: 8px; font-size: 12px; padding: 4px 10px; border: 2px solid var(--fd-text); border-radius: 999px; background: var(--fd-yellow); }
  .status i { width: 8px; height: 8px; border-radius: 50%; background: var(--fd-pink); animation: blink 1.6s steps(2, start) infinite; }
  @keyframes blink { to { visibility: hidden; } }

  .hero { display: grid; grid-template-columns: 1.25fr 1fr; gap: 24px; align-items: center; padding-top: 56px; padding-bottom: 40px; }
  .label { font-size: 12px; color: var(--fd-muted); margin: 0 0 18px; }
  h1 { font: 700 clamp(2rem, 4.2vw, 3.2rem)/1.08 var(--fd-display); letter-spacing: -0.03em; margin: 0 0 22px; }
  .lede { font-size: 1.12rem; max-width: 600px; color: var(--fd-text-soft); margin: 0; }
  .actions { display: flex; gap: 12px; flex-wrap: wrap; margin: 28px 0 0; }
  /* Bevelled 90s buttons, in modern colours. */
  .btn { display: inline-block; padding: 10px 18px; background: var(--fd-orange); color: var(--fd-text); font: 600 15px var(--fd-sans); text-decoration: none; border: 2px solid var(--fd-text); border-radius: 4px; box-shadow: inset 2px 2px 0 rgb(255 255 255 / 0.55), inset -2px -2px 0 rgb(0 0 0 / 0.18), 3px 3px 0 var(--fd-text); transition: transform .08s ease, box-shadow .08s ease; }
  .btn:hover { transform: translate(-1px, -1px); box-shadow: inset 2px 2px 0 rgb(255 255 255 / 0.55), inset -2px -2px 0 rgb(0 0 0 / 0.18), 4px 4px 0 var(--fd-text); }
  .btn:active { transform: translate(3px, 3px); box-shadow: inset 2px 2px 0 rgb(0 0 0 / 0.2); }
  .btn.alt { background: var(--fd-panel); }
  .hero-art { position: relative; }
  .mascot { width: 100%; max-width: 460px; margin-left: auto; filter: drop-shadow(6px 8px 0 rgb(0 0 0 / 0.12)); animation: glide 6s ease-in-out infinite; }
  @keyframes glide { 50% { transform: translateY(-10px) rotate(-1.5deg); } }
  .stamp { position: absolute; left: 4%; bottom: 6%; display: grid; place-items: center; width: 108px; height: 108px; border-radius: 50%; background: var(--fd-blue); color: #fff; font: 700 15px/1.1 var(--fd-mono); text-align: center; text-transform: uppercase; transform: rotate(-12deg); border: 3px dashed rgb(255 255 255 / 0.7); outline: 3px solid var(--fd-blue); }
  @media (max-width: 900px) { .hero { grid-template-columns: 1fr; padding-top: 36px; } .mascot { max-width: 340px; margin: 0 auto; } }

  .ticker { overflow: hidden; background: var(--fd-text); color: var(--fd-bg); border-block: 2px solid var(--fd-text); }
  .ticker .track { display: flex; width: max-content; animation: scroll 40s linear infinite; }
  .ticker span { padding: 10px 0; font-size: 13px; white-space: nowrap; }
  .ticker span::after { content: "✶"; margin: 0 22px; color: var(--fd-orange); }
  @keyframes scroll { to { transform: translateX(-50%); } }

  /* 90s window frame for figures */
  .win { margin: 0; border: 2px solid var(--fd-text); border-radius: 6px; overflow: hidden; background: #000; box-shadow: 6px 6px 0 var(--fd-text); }
  .win .bar { display: flex; align-items: center; gap: 6px; padding: 6px 8px 6px 12px; background: var(--fd-periwinkle); border-bottom: 2px solid var(--fd-text); color: var(--fd-text); }
  .win .bar span { flex: 1; font-size: 12px; font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .win .bar i { width: 16px; height: 14px; border: 2px solid var(--fd-text); border-radius: 3px; background: #ddd8ff; box-shadow: inset 1px 1px 0 #fff; }
  .win .bar i.x { background: var(--fd-pink); }
  .win.sm { box-shadow: 4px 4px 0 var(--fd-text); }
  .plate { margin-top: 48px; }
  figcaption { font-size: 12px; color: var(--fd-muted); margin-top: 14px; }

  main { padding-top: 40px; padding-bottom: 60px; }
  .row { display: grid; grid-template-columns: 230px 1fr; gap: 32px; padding: 52px 0; border-top: 2px solid var(--fd-text); }
  .num { margin: 0; font: 700 22px/1.2 var(--fd-display); letter-spacing: -0.02em; }
  .num b { display: block; font: 600 13px var(--fd-mono); color: var(--fd-orange); margin-bottom: 6px; }
  .body > p:first-child { margin-top: 0; }
  .body > p { max-width: 720px; }
  .small { font-size: 0.85rem; color: var(--fd-muted); }
  @media (max-width: 760px) { .row { grid-template-columns: 1fr; gap: 14px; padding: 38px 0; } .top { position: static; gap: 14px; flex-wrap: wrap; } .top nav { margin-left: 0; order: 3; width: 100%; } }

  .spec { margin: 26px 0 0; border-top: 1px solid var(--fd-line); max-width: 720px; }
  .spec div { display: grid; grid-template-columns: 160px 1fr; padding: 10px 0; border-bottom: 1px solid var(--fd-line); }
  .spec dt { font-size: 12px; color: var(--fd-muted); padding-top: 3px; }
  .spec dd { margin: 0; }

  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin-top: 22px; }
  .card { padding: 20px; border: 2px solid var(--fd-text); border-radius: 8px; box-shadow: 4px 4px 0 var(--fd-text); }
  .card h3 { margin: 4px 0 8px; font: 700 20px/1.2 var(--fd-display); letter-spacing: -0.01em; }
  .card p { margin: 0; }
  .card .k { font-size: 12px; opacity: 0.75; }
  .card code { background: rgb(255 255 255 / 0.45); }
  .orange { background: var(--fd-orange); }
  .pink { background: var(--fd-pink); }
  .purple { background: var(--fd-purple); color: #fff; }
  .purple code { background: rgb(255 255 255 / 0.2); color: #fff; }
  .stats .big { font: 700 46px/1 var(--fd-display); letter-spacing: -0.03em; margin-bottom: 12px; }

  .pair { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin: 26px 0 0; }
  @media (max-width: 640px) { .pair { grid-template-columns: 1fr; } }

  .shots { display: grid; grid-template-columns: 1fr 1fr; gap: 28px 22px; margin-top: 26px; }
  .polaroid { margin: 0; padding: 10px 10px 4px; background: #fff; border: 1px solid var(--fd-line); box-shadow: 0 8px 20px rgb(0 0 0 / 0.12); transform: rotate(var(--tilt)); transition: transform .2s ease; }
  .polaroid:hover { transform: rotate(0deg) scale(1.02); }
  .polaroid figcaption { display: flex; justify-content: space-between; margin: 8px 2px 6px; }
  .polaroid .look { color: var(--fd-blue); }
  @media (max-width: 640px) { .shots { grid-template-columns: 1fr; } }

  .plans { margin: 0; padding: 0; list-style: none; display: grid; gap: 12px; max-width: 760px; }
  .plans li { padding: 14px 16px 14px 44px; position: relative; background: var(--fd-panel); border: 1px solid var(--fd-line); border-radius: 6px; }
  .plans li::before { content: "▸"; position: absolute; left: 16px; top: 13px; color: var(--fd-orange); }

  .foot { background: var(--fd-yellow); border-top: 2px solid var(--fd-text); }
  .foot .wrap { display: grid; grid-template-columns: auto 1fr auto; gap: 18px; align-items: center; padding-top: 26px; padding-bottom: 30px; font-size: 14px; }
  .foot p { margin: 0; }
  .tiny-banner { image-rendering: pixelated; width: 320px; border: 2px solid var(--fd-text); }
  @media (max-width: 760px) { .foot .wrap { grid-template-columns: auto 1fr; } .tiny-banner { grid-column: 1 / -1; } }

  @media (prefers-reduced-motion: reduce) { .status i, .mascot, .ticker .track { animation: none; } }
</style>
