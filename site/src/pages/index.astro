---
// fractodactyl.dev: the plain-language explainer. Static HTML and CSS, no client script.
// Layout follows the owner's mockup: the viewer's pixel banner as the title bar, a tab
// bar of on-page anchors under the site nav (DEC-31), a hero on the "Parchment Edge
// Tropical Sunset Valley" pixel art with the mascot floating over it, then parchment
// cards. Colour pairs are declared below and checked by check-home.sh.
import Nav from "../components/Nav.astro";
const repo = "https://github.com/junovhs/fractodactyl";
const tabs = [
  ["#top", "Home"],
  ["#about", "About"],
  ["#rules", "Rules"],
  ["#speed", "Speed"],
  ["#receipts", "Receipts"],
  ["#explorer", "Explorer"],
  ["#plans", "Plans"],
];
const renders = [
  { n: "seahorse", label: "Seahorse Valley" },
  { n: "spiral", label: "Spiral at M(24,2)" },
  { n: "elephant", label: "Elephant Valley" },
  { n: "antenna", label: "Antenna minibrot" },
  { n: "deepvalley", label: "Deep valley" },
  { n: "coral", label: "Seahorse Valley, coral" },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Fractodactyl: deep Mandelbrot zooms, built in public</title>
    <meta name="description" content="Explore the Mandelbrot set and render deep zoom films with Fractodactyl. Open source, built in public." />
    <link rel="canonical" href="https://fractodactyl.dev/" />
    <link rel="icon" href="/favicon.png" />
    <meta property="og:title" content="Fractodactyl" />
    <meta property="og:description" content="Deep Mandelbrot zooms, built in public." />
    <meta property="og:image" content="https://fractodactyl.dev/img/minibrot-1600.webp" />
    <link rel="stylesheet" href="/docs-theme.css" />
    <style is:inline>
      /* Page colours. Text pairs meet WCAG AA (4.5:1); check-home.sh verifies each:
         aa: --c-ink on --c-page      aa: --c-ink on --c-card      aa: --c-soft on --c-card
         aa: --c-soft on --c-parch    aa: --c-ink on --c-parch     aa: --c-ink on --c-head
         aa: --c-ink on --c-tab       aa: --c-tab-on-ink on --c-tab-on
         aa: --c-ink on --c-gold      aa: --c-link on --c-card     aa: --c-orange-ink on --c-card
         aa: --c-pink-ink on --c-card aa: --c-purple-ink on --c-card aa: --c-foot-ink on --c-foot
         aa: --c-muted on --c-card    aa: --c-ink on --c-btn */
      :root {
        --c-frame: #3d47c9;
        --c-frame-dark: #1d2370;
        --c-page: #efe2c8;
        --c-card: #fbf4e6;
        --c-parch: #f2d9b2;
        --c-head: #ecd3a8;
        --c-line: #c9a978;
        --c-ink: #1f160c;
        --c-soft: #4a3720;
        --c-muted: #5c4a33;
        --c-link: #1a3ccf;
        --c-tab: #e4ddd2;
        --c-tab-on: #2848d8;
        --c-tab-on-ink: #ffffff;
        --c-gold: #f2c25e;
        --c-btn: #e4ddd2;
        --c-orange-ink: #8a3c00;
        --c-pink-ink: #9b1458;
        --c-purple-ink: #4b20b0;
        --c-foot: #1d2370;
        --c-foot-ink: #eef0ff;
      }
    </style>
  </head>
  <body>
    <Nav current="/" />
    <div class="page" id="top">
      <header class="top">
        <div class="titlebar">
          <span class="fill-r" aria-hidden="true"></span>
          <img class="band" src="/img/ui/banner-band.png" alt="Fractodactyl: Explore the Infinite!" width="640" height="66" />
        </div>
        <nav class="tabs" aria-label="On this page">
          <div class="tablist">{tabs.map(([href, label], i) => <a class={i === 0 ? "tab on" : "tab"} href={href}>{label}</a>)}</div>
        </nav>
      </header>

      <section class="hero">
        <div class="hero-copy">
          <p class="eyebrow">Fractodactyl</p>
          <h1>Explore the Mandelbrot set. Render deeper zoom films.</h1>
          <p class="lede">Fractodactyl is <b>open source</b> and built in public. We’re building faster ways to render longer, deeper zoom films, with an explorer for discovering places and designing their look.</p>
          <p class="actions">
            <a class="gold" href="/docs/"><img src="/img/ui/icon-map.png" alt="" width="30" height="30" />Explore the docs <span aria-hidden="true">→</span></a>
            <a class="gold" href="#explorer"><img src="/img/ui/icon-explore.png" alt="" width="30" height="30" />See the explorer <span aria-hidden="true">→</span></a>
          </p>
          <ul class="feats">
            <li><img src="/img/ui/icon-zoom.png" alt="" width="28" height="28" /><span>Precise<br />Mandelbrot detail</span></li>
            <li><img src="/img/ui/icon-snapshot.png" alt="" width="28" height="28" /><span>Fast<br />deep zooms</span></li>
            <li><img src="/img/ui/icon-fossils.png" alt="" width="28" height="28" /><span>Open source<br />MIT or Apache-2.0</span></li>
            <li><img src="/img/ui/icon-nest.png" alt="" width="28" height="28" /><span>Windows, Linux<br />modern GPUs</span></li>
          </ul>
        </div>
        <img class="mascot" src="/img/ui/mascot-900.webp" srcset="/img/ui/mascot-450.webp 450w, /img/ui/mascot-900.webp 900w" sizes="(max-width: 760px) 70vw, 380px" alt="Fractodactyl's mascot: a grinning pterodactyl in sunglasses with fractal-patterned wings" width="900" height="750" />
      </section>

      <main>
        <section class="explore" id="explorer">
          <div class="card">
            <h2 class="head"><img src="/img/ui/icon-explore.png" alt="" width="28" height="28" />Try the explorer</h2>
            <div class="body">
              <p>Explore the Mandelbrot set with Fractodactyl's desktop explorer, <code>fd-viewer</code>. Wander, zoom and try out different looks. It's an early build, and it has a pterodactyl in the title bar because we have standards.</p>
              <ul class="ticks">
                <li>Drag to pan, scroll to zoom</li>
                <li>Several colour looks</li>
                <li>Save places and snapshots</li>
                <li>Runs on the real <code>fd</code> renderer</li>
              </ul>
              <p class="actions"><a class="gold" href="/download/"><img src="/img/ui/icon-snapshot.png" alt="" width="30" height="30" />Download the desktop app <span aria-hidden="true">→</span></a><a href="/docs/explorer/">Explorer guide →</a></p>
            </div>
          </div>
          <figure class="shot">
            <img src="/img/viewer-minibrot-1280.webp" srcset="/img/viewer-minibrot-640.webp 640w, /img/viewer-minibrot-1280.webp 1280w" sizes="(max-width: 860px) 100vw, 620px" alt="fd-viewer showing the period-764 minibrot at zoom 4e48 in the master-ice look" width="1280" height="1082" loading="lazy" />
          </figure>
        </section>

        <div class="trio">
          <section class="card" id="about">
            <h2 class="head"><img src="/img/ui/icon-map.png" alt="" width="28" height="28" />What this is</h2>
            <div class="body"><p>A deep zoom dives into the Mandelbrot set until the screen is far smaller than an atom, and then keeps going. The set never runs out of detail, but the arithmetic gets harder the deeper you go, which is why long, deep zoom films are rare and slow to make. We're working to make them routine.</p></div>
          </section>
          <section class="card" id="rules">
            <h2 class="head"><img src="/img/ui/icon-fossils.png" alt="" width="28" height="28" />House rules</h2>
            <div class="body">
              <ol class="rules">
                <li><b class="n o">1</b><span><strong>Precise locations.</strong> Explore and render from the same saved coordinates and zoom depth.</span></li>
                <li><b class="n p">2</b><span><strong>It looks perfect, measurably.</strong> <code>fd filmcheck</code> compares every film frame with an exact render.</span></li>
                <li><b class="n v">3</b><span><strong>It earns its keep.</strong> Ideas that stop paying off get dropped, with a note in the log.</span></li>
              </ol>
            </div>
          </section>
          <section class="card" id="speed">
            <h2 class="head"><img src="/img/ui/icon-zoom.png" alt="" width="28" height="28" />Where the speed comes from</h2>
            <div class="body"><p>A conventional renderer follows each pixel's orbit step by step, often for hundreds of thousands of steps. Near a minibrot, Fractodactyl uses exact results about how those orbits behave (theorems of Tan Lei and Koenigs) to replace most of the steps with a few loops of a small map and one exact jump. It's a shortcut the maths guarantees, not a guess, and every result is checked against full-precision renders.</p></div>
          </section>
        </div>

        <div class="duo">
          <section class="card" id="receipts">
            <h2 class="head"><img src="/img/ui/icon-snapshot.png" alt="" width="28" height="28" />Receipts</h2>
            <div class="body">
              <p>Measurements on the zoom paths we've tested so far, against the best renderer that could use the same trick.</p>
              <table class="sheet">
                <thead><tr><th scope="col">Speed-up</th><th scope="col">What we measured</th></tr></thead>
                <tbody>
                  <tr><td class="num o">8-25×</td><td>Deep frames near a minibrot, against fd's own BLA renderer. 0 wrong pixels out of 777,600.</td></tr>
                  <tr><td class="num p">~1000×</td><td>Frames at a depth of 1e-1000: 0.023 s against 23-42 s, every pixel correct.</td></tr>
                  <tr><td class="num v">5×</td><td>A 10-second 1080p60 film on the GPU: 36.6 s against 183.6 s on every CPU core.</td></tr>
                </tbody>
              </table>
            </div>
          </section>
          <section class="card" id="renders">
            <h2 class="head"><img src="/img/ui/icon-nest.png" alt="" width="28" height="28" />Example renders<a class="mini" href="/docs/looks/">More looks →</a></h2>
            <div class="body">
              <div class="thumbs">
                {renders.map((r) => (<figure><img src={`/img/thumb/${r.n}.webp`} alt={r.label} width="480" height="270" loading="lazy" /><figcaption>{r.label}</figcaption></figure>))}
              </div>
            </div>
          </section>
        </div>

        <section class="card plans" id="plans">
          <h2 class="head"><img src="/img/ui/icon-explore.png" alt="" width="28" height="28" />What we're working on</h2>
          <div class="body cols">
            <div><h3>Fast paths for any film</h3><p>We're working to find and build the shortcuts automatically for any zoom path, not only the ones tested so far.</p></div>
            <div><h3>Directed films</h3><p>We aspire to a trip planner that finds minibrots, spirals and embedded Julia sets and strings them into journeys with proper climaxes.</p></div>
            <div><h3>A native explorer</h3><p>We aim to rebuild the viewer in Rust, drawing through the same pipeline as the films.</p></div>
          </div>
        </section>
      </main>

      <footer class="foot">
        <img src="/img/ui/mascot-icon.png" alt="" width="40" height="33" />
        <p><b>Fractodactyl</b><br />Open source deep-zoom renderer and explorer</p>
        <p class="links">MIT or Apache-2.0 · Built in public · <a href={repo}>GitHub ↗</a> · <a href="/docs/">Docs</a></p>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
  body { margin: 0; background: var(--c-frame-dark); color: var(--c-ink); font: 400 16px/1.6 var(--fd-sans); }
  a { color: var(--c-link); }
  a:focus-visible { outline: 2px solid var(--c-tab-on); outline-offset: 2px; }
  img { display: block; max-width: 100%; height: auto; }
  code { font: 0.86em var(--fd-mono); background: rgba(120, 80, 30, .1); padding: 0.05em 0.3em; border-radius: 3px; }

  /* The page is one window: navy line, blue frame */
  .page { max-width: 1180px; margin: 0 auto; border: 4px solid var(--c-frame); border-top: 0; background: var(--c-page); box-shadow: 0 0 0 1px var(--c-frame-dark); }

  /* Title bar: the viewer's banner at whole-pixel scale (2x wide screens, 1x narrow) */
  .titlebar { position: relative; height: 132px; overflow: hidden; background: url(/img/ui/banner-left.png) left top / 300px 132px repeat-x; image-rendering: pixelated; border-bottom: 2px solid var(--c-frame-dark); }
  .titlebar .band { position: absolute; top: 0; left: calc(50% - 690px); width: 1280px; max-width: none; height: 132px; image-rendering: pixelated; }
  .titlebar .fill-r { position: absolute; top: 0; bottom: 0; left: calc(50% + 590px); right: 0; background: url(/img/ui/banner-right.png) left top / 96px 132px repeat-x; image-rendering: pixelated; }
  @media (max-width: 1120px) {
    .titlebar { height: 66px; background-size: 150px 66px; }
    .titlebar .band { left: calc(50% - 345px); width: 640px; height: 66px; }
    .titlebar .fill-r { left: calc(50% + 295px); background-size: 48px 66px; }
  }

  /* Tab bar */
  .tabs { display: flex; flex-wrap: wrap; gap: 6px; justify-content: space-between; padding: 8px 10px; background: linear-gradient(#ece6dc, #d9d1c4); border-bottom: 2px solid var(--c-line); }
  .tablist { display: flex; flex-wrap: wrap; gap: 5px; }
  .tab { padding: 5px 14px; background: var(--c-tab); color: var(--c-ink); text-decoration: none; font: 600 14px var(--fd-sans); border-radius: 3px;
    box-shadow: inset -1px -1px 0 #4a443c, inset 1px 1px 0 #fff, inset -2px -2px 0 #9a9286; }
  .tab:hover { background: #f1ece4; }
  .tab.on { background: var(--c-tab-on); color: var(--c-tab-on-ink); box-shadow: inset 1px 1px 0 #10248f, inset -1px -1px 0 #7d93ff; }

  /* Hero over the pixel valley */
  .hero { position: relative; overflow: hidden; min-height: 560px; padding: 40px 44px 34px; border-bottom: 3px solid var(--c-frame);
    background: linear-gradient(90deg, var(--c-parch) 0%, var(--c-parch) 30%, rgba(242,217,178,.85) 46%, rgba(242,217,178,0) 66%), url(/img/ui/hero-valley.png) right center / cover; image-rendering: pixelated; }
  .hero-copy { position: relative; z-index: 2; max-width: 560px; }
  .eyebrow { margin: 0 0 8px; font: 600 13px var(--fd-mono); letter-spacing: .3em; text-transform: uppercase; color: var(--c-soft); }
  h1 { margin: 0 0 14px; font: 800 clamp(2rem, 3.6vw, 2.8rem)/1.1 var(--fd-display); letter-spacing: -0.02em; }
  .lede { margin: 0; font-size: 1.08rem; color: var(--c-ink); }
  .actions { display: flex; flex-wrap: wrap; gap: 14px; margin: 24px 0 0; }
  .gold { display: inline-flex; align-items: center; gap: 10px; padding: 10px 18px; background: linear-gradient(#f8d27c, var(--c-gold)); color: var(--c-ink); font: 700 17px var(--fd-sans); text-decoration: none;
    border: 2px solid #6b4a17; border-radius: 6px; box-shadow: inset 0 2px 0 rgba(255,255,255,.6), 0 3px 0 #6b4a17; }
  .gold img { width: 30px; height: 30px; }
  .gold:hover { background: linear-gradient(#fbe09f, #f6cd75); }
  .gold:active { transform: translateY(2px); box-shadow: inset 0 2px 0 rgba(255,255,255,.6), 0 1px 0 #6b4a17; }
  .feats { list-style: none; margin: 26px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 14px 22px; font-size: 13.5px; line-height: 1.3; }
  .feats li { display: flex; align-items: center; gap: 8px; }
  .mascot { position: absolute; z-index: 1; right: 10%; top: 150px; width: min(380px, 32vw); filter: drop-shadow(5px 8px 0 rgba(0,0,0,.18)); animation: glide 6s ease-in-out infinite; }
  @media (min-width: 901px) { .hero-copy { max-width: min(560px, 54%); } }
  @keyframes glide { 50% { transform: translateY(-10px) rotate(-1.5deg); } }
  @media (max-width: 900px) {
    .hero { padding: 28px 22px 26px; background: linear-gradient(var(--c-parch), rgba(242,217,178,.9) 60%, rgba(242,217,178,.7)), url(/img/ui/hero-valley.png) right bottom / cover; }
    .mascot { position: relative; right: auto; top: auto; width: min(320px, 80%); margin: 18px auto 0; }
  }

  /* Cards */
  main { padding: 18px; display: grid; grid-template-columns: minmax(0, 1fr); gap: 18px; }
  .card { background: var(--c-card); border: 2px solid var(--c-line); border-radius: 8px; overflow: hidden; box-shadow: 0 2px 0 rgba(107,74,23,.25); }
  .head { display: flex; align-items: center; gap: 10px; margin: 0; padding: 8px 14px; background: linear-gradient(#f3dcb4, var(--c-head)); border-bottom: 2px solid var(--c-line); font: 700 19px var(--fd-display); }
  .head img { width: 28px; height: 28px; }
  .mini { margin-left: auto; padding: 3px 10px; font: 600 13px var(--fd-sans); color: var(--c-ink); background: var(--c-btn); text-decoration: none; border-radius: 3px; box-shadow: inset -1px -1px 0 #4a443c, inset 1px 1px 0 #fff; }
  .body { padding: 16px 20px 18px; }
  .body > p { margin: 0 0 12px; }
  .body > p:last-child { margin-bottom: 0; }

  .explore { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.55fr); gap: 18px; align-items: start; }
  .shot { margin: 0; border: 3px solid var(--c-frame); border-radius: 6px; overflow: hidden; box-shadow: 0 4px 14px rgba(29,35,112,.25); }
  .ticks { list-style: none; margin: 0 0 4px; padding: 0; }
  .ticks li { position: relative; padding: 3px 0 3px 26px; }
  .ticks li::before { content: "✔"; position: absolute; left: 2px; color: #1f7a3a; font-weight: 700; }
  @media (max-width: 860px) { .explore { grid-template-columns: 1fr; } }

  .trio { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
  .duo { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr); gap: 18px; }
  @media (max-width: 960px) { .trio, .duo { grid-template-columns: 1fr; } }
  .rules { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .rules li { display: grid; grid-template-columns: 30px 1fr; gap: 10px; align-items: start; }
  .rules .n { display: grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; border: 1.5px solid var(--c-ink); font: 700 14px var(--fd-mono); color: var(--c-ink); }
  .n.o { background: #ffb347; } .n.p { background: #ff9ccb; } .n.v { background: #c4b2ff; }

  .sheet { width: 100%; border-collapse: collapse; background: #fff; font-size: 14.5px; }
  .sheet th { text-align: left; padding: 6px 10px; background: var(--c-head); border: 1px solid var(--c-line); font: 600 13px var(--fd-sans); }
  .sheet td { padding: 8px 10px; border: 1px solid #e2d3b8; vertical-align: top; }
  .sheet .num { font: 800 22px/1.1 var(--fd-display); white-space: nowrap; }
  .num.o { color: var(--c-orange-ink); } .num.p { color: var(--c-pink-ink); } .num.v { color: var(--c-purple-ink); }

  .thumbs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  .thumbs figure { margin: 0; }
  .thumbs img { aspect-ratio: 16 / 9; object-fit: cover; border: 2px solid var(--c-frame); border-radius: 3px; }
  .thumbs figcaption { text-align: center; font-size: 12.5px; color: var(--c-muted); margin-top: 3px; }
  @media (max-width: 560px) { .thumbs { grid-template-columns: repeat(2, minmax(0, 1fr)); } }

  .plans .cols { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px; }
  .plans h3 { margin: 0 0 4px; font: 700 16px var(--fd-display); }
  .plans p { margin: 0; color: var(--c-soft); font-size: 15px; }
  @media (max-width: 760px) { .plans .cols { grid-template-columns: 1fr; } }

  .foot { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 16px; padding: 14px 20px; background: var(--c-foot); color: var(--c-foot-ink); font-size: 14px; line-height: 1.35; }
  .foot p { margin: 0; }
  .foot .links { margin-left: auto; }
  .foot a { color: var(--c-foot-ink); }

  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } .mascot { animation: none; } }
</style>
