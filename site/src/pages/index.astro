---
// fractodactyl.dev: the plain-language explainer, as a 90s desktop. Static HTML and CSS,
// no client script. Each section is a window; the taskbar and desktop icons are links.
// The documentation pages under /docs/ are written by dopedocs from src/docs.ts.
const repo = "https://github.com/junovhs/fractodactyl";
const pic = (name: string) => ({
  src: `/img/${name}-1600.webp`,
  srcset: `/img/${name}-800.webp 800w, /img/${name}-1600.webp 1600w`,
});
const ticker = [
  "z ↦ z² + c",
  "period-764 minibrot at width 1e-48 in 0.25 s",
  "0 wrong pixels out of 777,600",
  "built in public",
  "every frame is the real set",
  "the pterodactyl is load-bearing",
];
const icons = [
  { href: "#welcome", glyph: "", img: "/img/ui/mascot-icon.png", label: "Fractodactyl", sel: true },
  { href: "/docs/", glyph: "📁", label: "Docs" },
  { href: "#receipts", glyph: "📊", label: "Receipts" },
  { href: "#explorer", glyph: "🖼️", label: "Screenshots" },
  { href: repo, glyph: "🌐", label: "GitHub" },
];
const tasks = [
  ["#readme", "readme.txt"],
  ["#rules", "house_rules.txt"],
  ["#speed", "speed.exe"],
  ["#receipts", "receipts.xls"],
  ["#explorer", "explorer.exe"],
  ["#todo", "todo.txt"],
];
const shots = [
  { n: "elephant", place: "Elephant Valley", look: "master-ice" },
  { n: "antenna", place: "Antenna minibrot", look: "ice" },
  { n: "deepvalley", place: "Deep valley, 1.3e12×", look: "smoke" },
  { n: "coral", place: "Seahorse Valley", look: "coral" },
];
const win = (glyph: string) => glyph;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Fractodactyl: deep Mandelbrot zooms, built in public</title>
    <meta name="description" content="Fractodactyl aims to be the fastest deep Mandelbrot zoom renderer that never fakes a frame. Open source, built in public." />
    <link rel="canonical" href="https://fractodactyl.dev/" />
    <link rel="icon" href="/favicon.png" />
    <meta property="og:title" content="Fractodactyl" />
    <meta property="og:description" content="Deep Mandelbrot zooms, built in public." />
    <meta property="og:image" content="https://fractodactyl.dev/img/minibrot-1600.webp" />
    <link rel="stylesheet" href="/docs-theme.css" />
  </head>
  <body>
    <svg class="confetti" viewBox="0 0 1440 1040" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <g opacity=".85">
        <polygon points="265,40 330,20 300,85" fill="#9b5de5"/><polygon points="1120,25 1175,8 1160,70" fill="#4cc9f0"/>
        <polygon points="40,780 95,745 90,815" fill="#2ec4b6"/><polygon points="15,960 80,935 55,1010" fill="#9b5de5"/>
        <polygon points="1390,560 1435,520 1440,600" fill="#f15bb5"/><polygon points="1300,980 1360,955 1350,1030" fill="#fee440"/>
        <rect x="880" y="10" width="70" height="12" rx="3" fill="#fee440" transform="rotate(18 915 16)"/>
        <rect x="20" y="880" width="58" height="11" rx="3" fill="#f15bb5" transform="rotate(-30 49 885)"/>
        <path d="M560 1012 q20 -20 40 0 t40 0 t40 0" stroke="#f15bb5" stroke-width="7" fill="none" stroke-linecap="round"/>
        <path d="M1340 300 q16 -16 32 0 t32 0" stroke="#fee440" stroke-width="6" fill="none" stroke-linecap="round"/>
        <circle cx="105" cy="740" r="7" fill="#f15bb5"/><circle cx="1380" cy="140" r="6" fill="#4cc9f0"/>
      </g>
    </svg>

    <nav class="icons" aria-label="Desktop">
      {icons.map((i) => (
        <a class={`icon${i.sel ? " sel" : ""}`} href={i.href}>
          {i.img ? <img src={i.img} alt="" width="56" height="47" /> : <span class="glyph">{i.glyph}</span>}
          <span class="name">{i.label}</span>
        </a>
      ))}
    </nav>

    <main class="desk">
      <section class="window hero" id="welcome">
        <div class="title"><img src="/img/ui/mascot-icon.png" alt="" width="18" height="15" /><span>Welcome to Fractodactyl</span><b class="btns"><i>_</i><i>□</i><i class="x">×</i></b></div>
        <div class="menubar"><a href="/docs/"><u>F</u>ile</a><a href="/docs/how-its-fast/"><u>H</u>ow it works</a><a href="/docs/results/"><u>R</u>esults</a><a href={repo}><u>S</u>ource</a><a href="/docs/"><u>H</u>elp</a></div>
        <div class="pane">
          <img class="banner" src="/img/ui/banner-band.png" alt="Fractodactyl: Explore the Infinite! A pixel-art pterodactyl banner." width="640" height="66" />
          <div class="hero-grid">
            <div>
              <h1>A deep-zoom renderer for the Mandelbrot set that never fakes a frame.</h1>
              <p>Fractodactyl is open source and built in public. We aim to make it the fastest way to render deep zoom films: films that go much deeper and run much longer than today's, made much faster, where every pixel is the real set at that depth.</p>
              <p class="actions"><a class="b95 primary" href="/docs/what-it-is/">How it works</a><a class="b95" href={repo}>View source</a></p>
            </div>
            <div class="hero-art">
              <img class="mascot" src="/img/ui/mascot-900.webp" srcset="/img/ui/mascot-450.webp 450w, /img/ui/mascot-900.webp 900w" sizes="(max-width: 760px) 70vw, 340px" alt="Fractodactyl's mascot: a grinning pterodactyl in sunglasses with fractal-patterned wings" width="900" height="750" />
              <span class="stamp">100%<br />real set</span>
            </div>
          </div>
        </div>
        <div class="marquee" aria-hidden="true"><div class="track">{[0, 1].map(() => ticker.map((t) => <span>{t}</span>))}</div></div>
      </section>

      <section class="window viewer" id="fig">
        <div class="title"><span>minibrot-764.fds · fd-viewer</span><b class="btns"><i>_</i><i>□</i><i class="x">×</i></b></div>
        <div class="canvas"><img {...pic("minibrot")} sizes="(max-width: 960px) 100vw, 880px" alt="A period-764 minibrot at width 1e-48, rendered by fd" width="1600" height="900" fetchpriority="high" /></div>
        <div class="statusbar">
          <span class="cell grow">Ready · master-ice<span class="progress"><i></i></span></span>
          <span class="cell">Width: 1e-48</span>
          <span class="cell">0.25 s</span>
          <span class="cell">zone-wgpu-f64</span>
        </div>
      </section>

      <section class="window" id="readme">
        <div class="title"><span>📄 readme.txt</span><b class="btns"><i>_</i><i>□</i><i class="x">×</i></b></div>
        <div class="pane doc">
          <h2>What this is</h2>
          <p>A deep zoom dives into the Mandelbrot set until the screen is far smaller than an atom, and then keeps going. The set never runs out of detail, but the arithmetic gets harder the deeper you go, which is why long, deep zoom films are rare and slow to make. We're working to make them routine.</p>
          <table class="t95">
            <tbody>
              <tr><th>Language</th><td>Rust, with the GPU code in WGSL on wgpu</td></tr>
              <tr><th>Aims to run on</th><td>Windows and Linux, any modern GPU, or no GPU at all</td></tr>
              <tr><th>Tested on so far</th><td>AMD RX 5700 XT, Mesa lavapipe, DX12 WARP</td></tr>
              <tr><th>Licence</th><td>MIT or Apache-2.0</td></tr>
              <tr><th>Mascot</th><td>One pterodactyl, sunglasses non-optional</td></tr>
            </tbody>
          </table>
        </div>
      </section>

      <section class="window" id="rules">
        <div class="title"><span>📜 house_rules.txt</span><b class="btns"><i>_</i><i>□</i><i class="x">×</i></b></div>
        <div class="pane doc">
          <h2>House rules</h2>
          <p>Every idea in the project has to pass three tests, in this order, or it doesn't ship.</p>
          <ol class="rules">
            <li><b class="n orange">1</b><div><strong>It shows the real set.</strong> Every frame is the actual Mandelbrot set at that place and depth. We never swap in a look-alike location to save time.</div></li>
            <li><b class="n pink">2</b><div><strong>It looks perfect, measurably.</strong> A viewer can't tell a film frame from an exact render of the same frame, and <code>fd filmcheck</code> checks that on every frame.</div></li>
            <li><b class="n purple">3</b><div><strong>It earns its keep.</strong> It makes zooms faster, deeper or longer. Ideas that stop paying off get dropped, with a note in the log about why.</div></li>
          </ol>
        </div>
      </section>

      <section class="window" id="speed">
        <div class="title"><span>⚙️ speed.exe</span><b class="btns"><i>_</i><i>□</i><i class="x">×</i></b></div>
        <div class="pane doc">
          <h2>Where the speed comes from</h2>
          <p>A conventional renderer follows each pixel's orbit step by step, often for hundreds of thousands of steps. Near a minibrot, Fractodactyl uses exact results about how those orbits behave (theorems of Tan Lei and Koenigs) to replace most of the steps with a few loops of a small map and one exact jump. It's a shortcut the maths guarantees, not a guess, and every result is checked against full-precision renders.</p>
          <div class="pair">
            <figure><div class="sunken"><img {...pic("seahorse")} sizes="(max-width: 760px) 100vw, 420px" alt="Seahorse Valley in the master-ice look" width="1600" height="900" loading="lazy" /></div><figcaption>Seahorse Valley, width 0.0065, master-ice.</figcaption></figure>
            <figure><div class="sunken"><img {...pic("spiral")} sizes="(max-width: 760px) 100vw, 420px" alt="A spiral near M(24,2) at width 1e-24 in the coral look" width="1600" height="900" loading="lazy" /></div><figcaption>Spiral at M(24,2), width 1e-24, coral: 4.1 s on the ordinary kernel.</figcaption></figure>
          </div>
          <p class="note">The minibrot in the viewer window above is twenty-four decades deeper than the spiral and took 0.25 s on the fast path.</p>
        </div>
      </section>

      <section class="window" id="receipts">
        <div class="title"><span>📊 receipts.xls</span><b class="btns"><i>_</i><i>□</i><i class="x">×</i></b></div>
        <div class="pane doc">
          <h2>Receipts</h2>
          <p>Measurements on the zoom paths we've tested so far, each against the best renderer that could use the same trick. Making the fast path cover any film is the big open problem we're working on.</p>
          <table class="t95 sheet">
            <thead><tr><th></th><th>Speed-up</th><th>What was measured</th></tr></thead>
            <tbody>
              <tr><th>1</th><td class="num orange">8-25×</td><td>Deep frames near a minibrot, against fd's own BLA renderer. 0 wrong pixels out of 777,600.</td></tr>
              <tr><th>2</th><td class="num pink">~1000×</td><td>Frames at a depth of 1e-1000: 0.023 s against 23-42 s, every pixel correct.</td></tr>
              <tr><th>3</th><td class="num purple">5×</td><td>A whole 10-second 1080p60 film on the GPU: 36.6 s against 183.6 s on every CPU core.</td></tr>
            </tbody>
          </table>
          <p class="note">Every number has its command and data in the public results log, filed right next to the ideas that didn't work.</p>
        </div>
      </section>

      <section class="window" id="explorer">
        <div class="title"><span>🦖 explorer.exe</span><b class="btns"><i>_</i><i>□</i><i class="x">×</i></b></div>
        <div class="pane doc">
          <h2>The explorer</h2>
          <p><code>fd-viewer</code> is our desktop explorer for wandering the set, picking places for films and trying looks. It's an early build that already drives the real renderer, and it has a pterodactyl in the title bar because we have standards.</p>
          <div class="shots">
            {shots.map((s) => (
              <figure>
                <div class="sunken"><img src={`/img/viewer-${s.n}-1280.webp`} srcset={`/img/viewer-${s.n}-640.webp 640w, /img/viewer-${s.n}-1280.webp 1280w`} sizes="(max-width: 760px) 100vw, 420px" alt={`fd-viewer showing ${s.place} in the ${s.look} look`} width="1280" height="1082" loading="lazy" /></div>
                <figcaption>{s.place} · <span class="look">{s.look}</span></figcaption>
              </figure>
            ))}
          </div>
          <p class="note">Unedited screenshots. Switching looks only recolours the picture; the maths isn't redone.</p>
        </div>
      </section>

      <section class="window" id="todo">
        <div class="title"><span>📝 todo.txt</span><b class="btns"><i>_</i><i>□</i><i class="x">×</i></b></div>
        <div class="pane doc">
          <h2>What we're working on</h2>
          <ul class="todo">
            <li><span class="box"></span><div><strong>Fast paths for any film.</strong> We're working to find and build the shortcuts automatically for any zoom path, not only the ones tested so far.</div></li>
            <li><span class="box"></span><div><strong>Directed films.</strong> We aspire to a trip planner that finds minibrots, spirals and embedded Julia sets and strings them into journeys with proper climaxes.</div></li>
            <li><span class="box"></span><div><strong>A native explorer.</strong> We aim to rebuild the viewer in Rust, drawing through the same pipeline as the films.</div></li>
          </ul>
          <p class="actions"><a class="b95 primary" href="/docs/">Read the docs</a><a class="b95" href={repo}>Follow along on GitHub</a></p>
        </div>
      </section>

      <p class="credits">Fractodactyl is open source (MIT or Apache-2.0) and built in public. Made with z² + c and an unreasonable amount of precision.</p>
    </main>

    <footer class="taskbar">
      <a class="start w95" href="#welcome"><img src="/img/ui/mascot-icon.png" alt="" width="24" height="20" /><b>Start</b></a>
      <nav class="tasks">{tasks.map(([href, label]) => <a class="task w95" href={href}>{label}</a>)}</nav>
      <span class="tray w95in"><i></i>building in public</span>
    </footer>
  </body>
</html>

<style is:global>
  /* Colours from the viewer mockup (viewer/mockup/index.html), plus the mascot's. */
  :root {
    --desk: #0e8a8c;
    --frame-outer: #1d2370;
    --frame-blue: #5e6cf6;
    --frame-light: #bbc4f8;
    --frame-inner: #313981;
    --menu: #d9cfc4;
    --paper: #f7f2ea;
    --peri-hi: #d4cbf2;
    --peri: #a6a1f4;
    --peri-lo: #9e96f7;
    --peri-line: #333886;
    --close: #fa4b6c;
    --close-hi: #ff8ea3;
    --select: #0a2fd6;
    --ink: #161310;
    --gray: #c1c0c1;
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; scroll-padding-top: 16px; -webkit-text-size-adjust: 100%; }
  body { margin: 0; min-height: 100vh; padding: 28px 16px 72px; color: var(--ink); font: 400 16px/1.6 var(--fd-sans);
    background: radial-gradient(ellipse at 30% 20%, #17a3a5, transparent 60%), radial-gradient(ellipse at 80% 90%, #0b7375, transparent 55%), var(--desk) fixed; }
  a { color: var(--select); }
  img { display: block; max-width: 100%; height: auto; }
  code { font: 0.86em var(--fd-mono); background: #ebe4d8; padding: 0.1em 0.35em; border-radius: 2px; }
  .confetti { position: fixed; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 0; }

  /* Desktop icons */
  .icons { position: fixed; top: 24px; left: 12px; z-index: 1; display: flex; flex-direction: column; gap: 18px; }
  .icon { width: 96px; display: flex; flex-direction: column; align-items: center; gap: 4px; color: #fff; text-decoration: none; text-align: center; font-size: 13px; text-shadow: 1px 1px 0 #000; }
  .icon .glyph { font-size: 38px; line-height: 1; filter: drop-shadow(2px 2px 0 rgba(0,0,0,.35)); }
  .icon img { width: 56px; height: auto; filter: drop-shadow(2px 2px 0 rgba(0,0,0,.35)); }
  .icon .name { padding: 1px 4px; }
  .icon.sel .name, .icon:hover .name, .icon:focus-visible .name { background: var(--select); outline: 1px dotted #fff; }
  @media (max-width: 1240px) { .icons { display: none; } }

  /* Windows: navy line / blue / light stripe, as the viewer's frame */
  .desk { position: relative; z-index: 1; max-width: 900px; margin: 0 auto; display: grid; grid-template-columns: minmax(0, 1fr); gap: 30px; }
  .window { min-width: 0; }
  .window { border: 1px solid var(--frame-outer); border-radius: 7px 7px 4px 4px; padding: 3px; background: linear-gradient(#7e8bfa, var(--frame-blue) 30%, #5363ec); box-shadow: 6px 8px 0 rgba(0,0,0,.28); }
  .desk > .window:nth-child(even) { margin-left: 28px; margin-right: -28px; }
  @media (max-width: 1000px) { .desk > .window:nth-child(even) { margin: 0; } }
  .title { display: flex; align-items: center; gap: 8px; padding: 4px 4px 6px 8px; color: #fff; font: 700 14px var(--fd-sans); text-shadow: 1px 1px 0 var(--frame-outer); }
  .title span { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .btns { display: flex; gap: 3px; }
  .btns i { width: 24px; height: 21px; display: grid; place-items: center; font: 900 13px/1 var(--fd-sans); font-style: normal; color: #000; text-shadow: none; border: 2px solid var(--peri-line); border-radius: 4px;
    background: linear-gradient(var(--peri-hi), var(--peri) 40%, var(--peri-lo)); box-shadow: inset 2px 2px 0 rgba(255,255,255,.75), inset -2px -2px 0 rgba(58,52,170,.35); }
  .btns i.x { background: linear-gradient(var(--close-hi), var(--close) 40%, #ef3d60); }
  .menubar { display: flex; flex-wrap: wrap; gap: 2px; padding: 3px 6px 4px; background: var(--menu); border: 1px solid var(--frame-inner); border-bottom: 0; }
  .menubar a { padding: 2px 9px; color: var(--ink); text-decoration: none; font-size: 14px; }
  .menubar a:hover { background: var(--select); color: #fff; }
  .pane { background: var(--paper); border: 1px solid var(--frame-inner); padding: 22px 26px 24px; }
  .doc h2 { margin: 0 0 10px; font: 700 24px/1.2 var(--fd-display); letter-spacing: -0.01em; }
  .doc p { margin: 0 0 14px; max-width: 70ch; }
  .note { font-size: 14px; color: #5b5146; }

  /* Hero */
  .banner { width: 640px; max-width: none; margin: -22px auto 18px; image-rendering: pixelated; border: 1px solid var(--frame-inner); border-top: 0; }
  @media (max-width: 720px) { .banner { width: 100%; max-width: 320px; } }
  .hero-grid { display: grid; grid-template-columns: 1fr 300px; gap: 16px; align-items: center; }
  .hero h1 { margin: 0 0 14px; font: 700 clamp(1.6rem, 3.2vw, 2.2rem)/1.15 var(--fd-display); letter-spacing: -0.02em; }
  .hero-art { position: relative; }
  .mascot { width: 100%; filter: drop-shadow(4px 6px 0 rgba(0,0,0,.15)); animation: glide 6s ease-in-out infinite; }
  @keyframes glide { 50% { transform: translateY(-8px) rotate(-1.5deg); } }
  .stamp { position: absolute; left: -6px; bottom: 0; display: grid; place-items: center; width: 92px; height: 92px; border-radius: 50%; background: var(--select); color: #fff; font: 700 13px/1.1 var(--fd-mono); text-align: center; text-transform: uppercase; transform: rotate(-12deg); border: 3px dashed rgba(255,255,255,.7); outline: 3px solid var(--select); }
  @media (max-width: 720px) { .hero-grid { grid-template-columns: 1fr; } .hero-art { max-width: 260px; margin: 0 auto; } }
  .marquee { max-width: 100%; overflow: hidden; margin-top: 3px; background: #000; border: 1px solid var(--frame-inner); color: #7CFC00; font: 13px var(--fd-mono); }
  .marquee .track { display: flex; width: max-content; animation: scroll 40s linear infinite; }
  .marquee span { padding: 6px 0; white-space: nowrap; }
  .marquee span::after { content: "✶"; margin: 0 20px; color: var(--fd-orange); }
  @keyframes scroll { to { transform: translateX(-50%); } }

  /* Win95 buttons */
  .actions { display: flex; flex-wrap: wrap; gap: 10px; margin: 20px 0 0 !important; }
  .b95, .w95 { background: var(--gray); box-shadow: inset -1px -1px 0 #0a0a0a, inset 1px 1px 0 #fff, inset -2px -2px 0 #808080, inset 2px 2px 0 #dfdfdf; }
  .b95 { display: inline-block; padding: 8px 18px; color: var(--ink); font: 600 15px var(--fd-sans); text-decoration: none; }
  .b95.primary { outline: 1px solid #000; outline-offset: -1px; }
  .b95:active { box-shadow: inset 1px 1px 0 #0a0a0a, inset -1px -1px 0 #fff, inset 2px 2px 0 #808080; }
  .b95:focus-visible { outline: 1px dotted #000; outline-offset: -5px; }
  .w95in { box-shadow: inset 1px 1px 0 #808080, inset -1px -1px 0 #fff; }

  /* Viewer window for Fig. 1 */
  .viewer .canvas { border: 3px solid; border-color: #3a2a9c #7b6cf0 #7b6cf0 #3a2a9c; outline: 1px solid var(--frame-inner); background: #000; }
  .statusbar { display: flex; flex-wrap: wrap; gap: 5px; padding: 4px; background: var(--menu); border: 1px solid var(--frame-inner); border-top: 0; font-size: 13px; }
  .cell { padding: 3px 10px; background: #e0d9d3; box-shadow: inset 1px 1px 0 #77706a, inset -1px -1px 0 #fff; white-space: nowrap; display: flex; align-items: center; gap: 10px; }
  .cell.grow { flex: 1; min-width: 200px; }
  .progress { flex: 1; height: 16px; padding: 2px; background: #f4f0ea; box-shadow: inset 1px 1px 0 #77706a, inset -1px -1px 0 #fff; }
  .progress i { display: block; height: 100%; background: repeating-linear-gradient(90deg, #2286fb 0 12px, #0d2a78 12px 14px); }
  @media (max-width: 560px) { .statusbar .cell:not(.grow) { display: none; } }

  /* Sunken frames and tables */
  .sunken { padding: 2px; background: #fff; box-shadow: inset 1px 1px 0 #808080, inset -1px -1px 0 #fff, inset 2px 2px 0 #0a0a0a; }
  figure { margin: 0; }
  figcaption { font-size: 13px; color: #5b5146; margin-top: 6px; }
  .look { color: var(--select); font-weight: 600; }
  .pair, .shots { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin: 6px 0 16px; }
  @media (max-width: 640px) { .pair, .shots { grid-template-columns: 1fr; } }
  .t95 { width: 100%; border-collapse: collapse; background: #fff; font-size: 15px; box-shadow: inset 1px 1px 0 #808080; border: 1px solid #808080; margin: 6px 0 4px; }
  .t95 th, .t95 td { padding: 8px 12px; border: 1px solid #c9c2b6; text-align: left; vertical-align: top; }
  .t95 tbody th { width: 34%; background: #efe9df; font-weight: 600; }
  .sheet thead th { background: var(--gray); font: 600 13px var(--fd-sans); box-shadow: inset -1px -1px 0 #808080, inset 1px 1px 0 #fff; }
