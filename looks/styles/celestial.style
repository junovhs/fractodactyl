# Gold boundary emission, cool layered surfaces and tangent-directed ribbons.
version 1
surface sculpted
emission light
black = color #020510
navy = color #071b40
blue = color #218cff
violet = color #966bda
gold = color #ffac40
white = color #ffe0a0
normal = source normal
tangent = source tangent
de = source de
time = source time
one = scalar 1
half = scalar 0.5
tau = scalar 6.2831853
phase_frequency = param 0.11
phase = phase phase_frequency
speed = param 0.12
travel = mul time speed
moving = sub phase travel
angle = mul moving tau
cosine = cos angle
wave0 = mul cosine half
wave = add wave0 half
ribbon_power = param 5
peak = pow wave ribbon_power
broad_width = param 48
broad = boundary de broad_width
ribbon_mask = mul broad peak
hue_axis = vector 0.6 -0.8
orientation0 = dot normal hue_axis
orientation1 = mul orientation0 half
orientation = add orientation1 half
cool = mix blue violet orientation
ribbon_color = mul cool ribbon_mask
flow_length = param 4
ribbon_flow = flow ribbon_color tangent flow_length
ribbon_strength = param 1.2
ribbons = mul ribbon_flow ribbon_strength
edge_width = param 0.08
edge = boundary de edge_width
edge_strength = param 3
edge_gate = pow wave ribbon_power
edge_floor = scalar 0.12
edge_weight = add edge_gate edge_floor
edge_mask = mul edge edge_weight
edge_energy = mul edge_mask edge_strength
edge_color = mix gold white wave
boundary = mul edge_color edge_energy
light = add boundary ribbons
base = mix navy cool wave
slope = param 1.7
sun = vector -0.8 -0.6
relief = light normal slope sun
striation_frequency = param 1.3
striation = band striation_frequency travel
terrace_depth = param 0.4
terrace0 = mul striation terrace_depth
terrace = sub one terrace0
terrain = mul relief terrace
surface_strength = param 0.1
surface_light = mul terrain surface_strength
sculpted = mul base surface_light
