# Shared material graph for the viewer's curated presets.
# All controls are runtime uniforms. Stream is bounded curved convolution.
version 1
output final
zero = scalar 0
one = scalar 1
two = scalar 2
half = scalar 0.5
navy = color #112341
violet = color #6d337f
cyan = color #139eea
indigo = color #6644ef
gold = color #ffac42
rose = color #ef6791
normal = source normal
tangent = source tangent
de = source de
escaped = source escaped
fold_frequency = param 0.12
fold_depth = param 3
detail_frequency = param 0.7
detail_strength = param 0.25
phase = param 0
light_angle = param -0.9
light_height = param 0.5
ambient = param 0.08
surface_gain = param 0.5
cavity = param 0.65
gloss = param 18
metal = param 0.6
cool_hue = param 0
warm_hue = param 0
cool_gain = param 0.8
warm_gain = param 1.5
edge_width = param 0.35
atmosphere_width = param 35
mist_radius = param 14
mist_gain = param 0.6
exposure = param 1
wave = band fold_frequency phase
fine_wave = band detail_frequency phase
wave_two = mul wave two
signed_wave = sub wave_two one
fine_two = mul fine_wave two
fine_signed = sub fine_two one
coarse_slope = mul signed_wave fold_depth
fine_slope = mul fine_signed detail_strength
slope0 = add coarse_slope fine_slope
slope = add slope0 one
lx = cos light_angle
ly = sin light_angle
direction = compose lx ly
orientation = dot normal direction
slope_dot = mul slope orientation
numerator = add slope_dot light_height
slope_squared = mul slope slope
normal_length_squared = add slope_squared one
normal_length = pow normal_length_squared half
light_squared = mul light_height light_height
light_length_squared = add light_squared one
light_length = pow light_length_squared half
denominator = mul normal_length light_length
lambert0 = div numerator denominator
lambert = clamp lambert0 zero one
back0 = sub zero lambert0
back = clamp back0 zero one
backlight = pow back two
highlight = pow lambert gloss
groove0 = mul wave cavity
groove = sub one groove0
shade0 = add lambert ambient
shade = mul shade0 groove
surface_hue = mix navy violet cool_hue
material0 = mul surface_hue shade
material = mul material0 surface_gain
cool_color = mix cyan indigo cool_hue
warm_color = mix gold rose warm_hue
edge = boundary de edge_width
atmosphere = boundary de atmosphere_width
footprint_denominator = add de half
footprint = div de footprint_denominator
cool_visible = pow footprint half
cool_base = mul backlight atmosphere
cool_light0 = mul cool_base cool_visible
cool_light1 = mul cool_light0 cool_gain
cool_light = mul cool_color cool_light1
warm_base = mul edge highlight
warm_light0 = mul warm_base footprint
warm_light1 = mul warm_light0 warm_gain
warm_light = mul warm_color warm_light1
specular_base = mul highlight metal
specular0 = mul specular_base footprint
specular = mul warm_color specular0
surface0 = add material specular
surface_image = image surface0
cool_image = image cool_light
warm_image = image warm_light
tangent_image = image tangent
radius_image = image mist_radius
gain_image = image mist_gain
exposure_image = image exposure
mask_image = image escaped
mist0 = stream cool_image tangent_image radius_image
mist = mul mist0 gain_image
core = add cool_image warm_image
illumination = add core mist
combined = add surface_image illumination
exposed = mul combined exposure_image
final = mul exposed mask_image
